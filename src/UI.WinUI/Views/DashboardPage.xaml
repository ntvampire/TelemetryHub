<Page
    x:Class="KsitalTelemetryHub.UI.WinUI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:KsitalTelemetryHub.UI.WinUI.Models">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: Search and Quick Actions -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                Grid.Column="0"
                PlaceholderText="Поиск объекта по названию, району или номеру телефона..."
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                TextChanged="AutoSuggestBox_TextChanged"/>

            <Button Grid.Column="1" Click="BtnAddObject_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;"/>
                    <TextBlock Text="Новый объект"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Command="{x:Bind ViewModel.RefreshDataCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;"/>
                    <TextBlock Text="Обновить"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Objects Grid / List (Fluent Cards) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Objects, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ObjectDisplayItem">
                        <Border
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,10"
                            Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Name and Phone -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind PhoneNumber}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                        <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind DeviceTypeName}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind District}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Column 2: 220V Status -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Электросеть" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{x:Bind PowerStatusText}" FontWeight="Bold" FontSize="14" Foreground="{x:Bind StatusBadgeBrush}"/>
                                    <TextBlock Text="{x:Bind BatteryVoltage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                </StackPanel>

                                <!-- Column 3: Alarm Status -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Статус" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{x:Bind AlarmDescription, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12" Foreground="{x:Bind StatusBadgeBrush}"/>
                                </StackPanel>

                                <!-- Column 4: Temperatures -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="Показания датчиков" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{x:Bind TemperaturesFormatted}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Column 5: Action Button -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Управление" Click="BtnManageObject_Click" Tag="{x:Bind}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
