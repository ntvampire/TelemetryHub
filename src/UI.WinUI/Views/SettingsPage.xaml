<Page
    x:Class="KsitalTelemetryHub.UI.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Настройки системы и базы данных" FontSize="20" FontWeight="SemiBold"/>

            <!-- Section 1: COM Port and Service -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Аппаратный GSM-модем (Служба Service.Worker)" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Служба сбора является единственным монопольным владельцем COM-порта. WinUI интерфейс считывает телеметрию из базы данных через IPC-таблицу SystemStatus без коллизий портов."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Статус порта" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.ComPortStatus, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Статус модема" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.ModemStatus, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section 2: Database & Backup -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Резервное копирование базы данных SQLite (WAL-Safe)" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Горячее копирование с поддержкой WAL-журналирования без остановки сервиса телеметрии." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Создать резервную копию" Click="BtnBackup_Click"/>
                        <Button Content="Импорт объектов из Excel (.xlsx)" Click="BtnImportExcel_Click"/>
                        <Button Content="Экспорт в Excel" Click="BtnExportExcel_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtBackupStatus" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Section 3: Notification settings -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Звуковые уведомления и сирена" FontWeight="SemiBold" FontSize="15"/>
                    <ToggleSwitch Header="Включить звуковую сирену при авариях (220V, обрыв контура)" IsOn="{x:Bind ViewModel.IsSoundAlarmEnabled, Mode=TwoWay}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
