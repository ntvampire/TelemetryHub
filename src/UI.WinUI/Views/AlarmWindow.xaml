<Window
    x:Class="KsitalTelemetryHub.UI.WinUI.Views.AlarmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ВНИМАНИЕ: ТРЕВОГА! — Telemetry Hub">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Red Warning Banner -->
        <Border Grid.Row="0" Background="#D32F2F" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="28" Foreground="White" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ТЕХНОЛОГИЧЕСКАЯ ТРЕВОГА" FontWeight="Bold" FontSize="18" Foreground="White"/>
                    <TextBlock Text="Требуется немедленное внимание оператора" FontSize="12" Foreground="#FFCDD2"/>
                </StackPanel>

                <Border x:Name="BrdAlarmCount" Grid.Column="2" Background="#B71C1C" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="TxtAlarmCount" Text="1 из 1" FontSize="12" FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" Padding="20,16">
            <StackPanel Spacing="14">
                <!-- Card 1: Object Information -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE707;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Объект мониторинга" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtObjectName" Text="Название объекта" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis"/>

                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Район / участок:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="TxtDistrict" Text="Основной участок" FontWeight="Medium" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Тип прибора:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="TxtDeviceType" Text="КСИТАЛ GSM" FontWeight="Medium" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
                                <TextBlock Text="Номер SIM-карты:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="TxtPhoneNumber" Text="+7..." FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Alarm Details -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="#E74C3C"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="#E74C3C"/>
                            <TextBlock Text="Данные аварии" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtAlarmDesc" Text="Описание тревоги" FontSize="15" FontWeight="SemiBold" Foreground="#D32F2F" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="Зафиксировано:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtTimestamp" Text="18.09.2026 10:00:00" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pager if multiple alarms -->
                <Grid x:Name="GridPager" Visibility="Collapsed" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnPrevAlarm" Content="◀ Предыдущая" Click="BtnPrevAlarm_Click" Grid.Column="0"/>
                    <TextBlock x:Name="TxtPagerInfo" Text="Тревога 1 из 2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" Grid.Column="1"/>
                    <Button x:Name="BtnNextAlarm" Content="Следующая ▶" Click="BtnNextAlarm_Click" Grid.Column="2"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Buttons Bar -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnAcknowledge"
                        Click="BtnAcknowledge_Click"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        Style="{ThemeResource AccentButtonStyle}"
                        Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;"/>
                        <TextBlock Text="Подтвердить" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSnooze"
                        Click="BtnSnooze_Click"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE823;"/>
                        <TextBlock Text="Отложить (5 мин)"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
