<Window
    x:Class="KsitalTelemetryHub.UI.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ksital Telemetry Hub (WinUI 3)">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            ItemInvoked="NavView_ItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Диспетчер объектов" Tag="dashboard" Icon="Home"/>
                <NavigationViewItem Content="Журнал аварий" Tag="alarms" Icon="ReportHacked"/>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <!-- Hardware Status Indicator in Footer (No COM collision) -->
                <StackPanel Margin="12,8" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.IsComConnected, Mode=OneWay, Converter={StaticResource BoolToColorConverter}, FallbackValue='#2ECC71'}"/>
                        <TextBlock Text="{x:Bind ViewModel.ComPortStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.IsModemConnected, Mode=OneWay, Converter={StaticResource BoolToColorConverter}, FallbackValue='#2ECC71'}"/>
                        <TextBlock Text="{x:Bind ViewModel.ModemStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
