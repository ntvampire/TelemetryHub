<Window
    x:Class="KsitalTelemetryHub.UI.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Telemetry Hub">

    <Grid x:Name="RootGrid">
        <NavigationView
            x:Name="NavView"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            ItemInvoked="NavView_ItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Диспетчер объектов" Tag="dashboard" Icon="Home"/>
                <NavigationViewItem Content="Журнал аварий" Tag="alarms" Icon="ReportHacked"/>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <!-- Hardware Status Indicator in Footer (No COM collision) -->
                <StackPanel Margin="12,8" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" Fill="{Binding ComStatusColor}"/>
                        <TextBlock Text="{Binding ComPortStatus}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" Fill="{Binding ModemStatusColor}"/>
                        <TextBlock Text="{Binding ModemStatus}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
