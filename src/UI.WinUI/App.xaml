<Application
    x:Class="KsitalTelemetryHub.UI.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToColorConverter xmlns:converters="using:KsitalTelemetryHub.UI.WinUI.Converters" x:Key="BoolToColorConverter" />
            <!-- Global styles and color accents for Fluent Design -->
            <SolidColorBrush x:Key="AccentSuccessBrush" Color="#2ECC71"/>
            <SolidColorBrush x:Key="AccentDangerBrush" Color="#E74C3C"/>
            <SolidColorBrush x:Key="AccentWarningBrush" Color="#F39C12"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E1E2E"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
