<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KsitalTelemetryHub.UI.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="KsitalTelemetryHub.UI.Avalonia.Views.MainWindow"
        Title="Telemetry Hub"
        Icon="/Assets/app.ico"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        x:DataType="vm:MainViewModel">

    <Grid ColumnDefinitions="250,*">
        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="12,16">
                <!-- App Title Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,20" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📡" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Telemetry Hub" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Кроссплатформенная редакция (Beta)" FontSize="10" Foreground="#757575" Margin="26,0,0,0"/>
                </StackPanel>

                <!-- Navigation Menu Items -->
                <StackPanel Grid.Row="1" Spacing="4">
                    <!-- Nav 1: Journal -->
                    <Button x:Name="BtnNavAlarms"
                            Click="BtnNavAlarms_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="#2D2D2D"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="📋" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Журнал событий" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                            <Border Grid.Column="2"
                                    IsVisible="{Binding HasUnacknowledgedAlarms}"
                                    Background="#E74C3C"
                                    CornerRadius="10"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnacknowledgedAlarmsCount}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Nav 2: Dashboard -->
                    <Button x:Name="BtnNavDashboard"
                            Click="BtnNavDashboard_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🏠" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Диспетчер объектов" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nav 3: Settings -->
                    <Button x:Name="BtnNavSettings"
                            Click="BtnNavSettings_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Параметры" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer: The 5 System and Hardware Indicators -->
                <Border Grid.Row="2" Background="#252526" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <StackPanel Spacing="6">
                        <!-- 1. Objects count -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="2,2">
                            <TextBlock Text="📊" FontSize="11" Width="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalObjectsText}" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 2. Worker Service (Click to restart) -->
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="2,2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding RestartWorkerServiceCommand}"
                                ToolTip.Tip="Нажмите для запуска / перезапуска службы сбора данных">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding ServiceStatusBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ServiceStatusText}" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                <ProgressBar IsIndeterminate="{Binding IsServiceRestarting}"
                                             IsVisible="{Binding IsServiceRestarting}"
                                             Width="16" Height="4" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. Modem & COM port -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="2,2">
                            <Ellipse Width="8" Height="8" Fill="{Binding ModemStatusBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ModemStatusText}" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 4. Cellular operator -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="2,2">
                            <TextBlock Text="📶" FontSize="11" Width="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ModemOperatorText}" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 5. Signal level (Click to query signal) -->
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="2,2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding RequestSignalCheckCommand}"
                                ToolTip.Tip="Нажмите для замера уровня сигнала (автоматически опрашивается раз в 5 минут)">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="▲" FontSize="11" Foreground="{Binding ModemSignalBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModemSignalText}" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                <ProgressBar IsIndeterminate="{Binding IsSignalRefreshing}"
                                             IsVisible="{Binding IsSignalRefreshing}"
                                             Width="16" Height="4" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Content Area -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Background="#181818"/>
    </Grid>
</Window>
